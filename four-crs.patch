+{% extends "base.html" %}
+{% block title %}Teams{% endblock %}
+{% block content %}
+<div class="page-head-row">
+    <div class="page-head">
+        <div class="eyebrow">Browse</div>
+        <h1>Teams</h1>
+        <p class="sub">Read-only view of every team's roster, purse and captain. Click a team for the full squad.</p>
+    </div>
+</div>
+
+<div class="team-grid">
+    {% for team in teams %}
+    <div class="team-card" style="border-top-color:{{ team.primary_color or '#e8ab2f' }};">
+        <div class="team-card-head">
+            <div class="team-name-row">
+                <img class="team-logo" src="{{ team_logo(team) }}" alt="{{ team.name }} logo" onerror="this.src='/static/img/placeholder_team_logo.svg'">
+                <div>
+                    <div class="team-name">{{ team.name }}</div>
+                    <div class="team-meta">
+                        <span>Manager: {{ team.manager.name if team.manager else "Not assigned" }}</span>
+                        <span>Captain: {{ team.captain.user.name if team.captain else "Not yet" }}</span>
+                    </div>
+                </div>
+            </div>
+        </div>
+        <div class="team-stats">
+            <div><b>₹{{ (team.purse_remaining|inr) }}</b><span>Purse Left</span></div>
+            <div><b>{{ team.players|length }}</b><span>Players</span></div>
+            <div><b>₹{{ (team.purse_total|inr) }}</b><span>Total Purse</span></div>
+        </div>
+        <a href="/team/{{ team.id }}" class="btn btn-outline btn-sm" style="width:100%;justify-content:center;margin-top:14px;text-decoration:none;">View roster</a>
+    </div>
+    {% else %}
+    <div class="empty-state panel"><p>No teams yet.</p></div>
+    {% endfor %}
+</div>
+{% endblock %}
